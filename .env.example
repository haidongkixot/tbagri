# Chép tệp này thành .env.local rồi điền giá trị. KHÔNG commit .env.local.
# Sinh chuỗi ngẫu nhiên: openssl rand -hex 32

# --- Bắt buộc ---------------------------------------------------------------
# Khóa ký cookie phiên quản trị. Production bắt buộc có và dài ≥ 32 ký tự,
# thiếu thì đăng nhập /admin báo "lỗi hệ thống".
SESSION_SECRET=
# Muối để băm địa chỉ IP trước khi lưu (giới hạn số lần gửi form).
IP_HASH_SALT=

# --- Cơ sở dữ liệu ----------------------------------------------------------
# Để trống khi chạy máy cá nhân: dữ liệu lưu bằng PGlite ở .data/pglite.
# Production dùng chuỗi kết nối Neon Postgres.
DATABASE_URL=
# Thư mục PGlite, chỉ đổi khi cần chạy song song (e2e dùng .data/e2e).
# PGLITE_DIR=

# --- Địa chỉ trang ----------------------------------------------------------
# Dùng cho sitemap, canonical, JSON-LD. Ví dụ: https://tbagri.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- Tài khoản quản trị đầu tiên (tùy chọn) ---------------------------------
# Có đủ ADMIN_EMAIL + ADMIN_PASSWORD thì bước build (scripts/bootstrap.ts) hoặc
# `npm run admin:create` sẽ tạo/đặt lại tài khoản. Mật khẩu ≥ 12 ký tự, có chữ và số.
# Tạo xong nhớ XÓA ADMIN_PASSWORD khỏi biến môi trường.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
# ADMIN_ROLE=

# --- Ảnh tải lên (tùy chọn) -------------------------------------------------
# Production dùng Vercel Blob. Để trống khi chạy máy cá nhân: ảnh lưu ở public/uploads.
# BLOB_READ_WRITE_TOKEN=

# --- Email báo lead mới (tùy chọn) ------------------------------------------
# Không có RESEND_API_KEY thì lead vẫn lưu vào CSDL, chỉ không gửi email.
# RESEND_API_KEY=
# LEAD_NOTIFY_TO=
# LEAD_NOTIFY_FROM=
